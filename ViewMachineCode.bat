@echo off
rem ============================================================
rem  Art Code - view this machine's machine code (for activation)
rem  Double-click to run. It reads your local Art Code device id,
rem  derives the 32-char machine code (same as shown inside the app),
rem  prints it and copies it to the clipboard.
rem  The script body is embedded as Base64(UTF-16) at the last line
rem  to avoid any codepage/encoding problems on non-Chinese systems.
rem ============================================================
title Art Code - Machine Code
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
